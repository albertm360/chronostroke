# Settles the conventions this codebase already follows. Nothing here is a new rule — it is a
# description of the existing style so an IDE stops proposing something else.
root = true

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,json,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false     # two trailing spaces is a Markdown line break

[*.{csproj,slnx,xaml,xml}]
indent_size = 2

[*.cs]
# Namespaces, usings
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Braces. Allman everywhere, and required except where the whole statement fits on one line —
# which is how the modifier-flag runs in KeystrokeSender, GlobalHotKey and KeyCombo are written.
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_prefer_braces = when_multiline:suggestion

# Expression-bodied members: used for one-liners in this codebase, not for blocks.
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion

# Modern C# the codebase already leans on
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_not_pattern = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = true:silent

# Accessibility and naming
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_case
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

# Interop: Win32 struct fields are transcribed with their native names on purpose, so the
# declaration can be diffed against winuser.h by eye.
[ChronoStroke/Interop/NativeMethods.cs]
dotnet_diagnostic.IDE1006.severity = none
