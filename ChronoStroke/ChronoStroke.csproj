<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Required by [LibraryImport]: the source generator emits pointer-based marshalling
         stubs. This does not make our own code unsafe - we write no pointer code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <Product>ChronoStroke</Product>
    <AssemblyTitle>ChronoStroke</AssemblyTitle>
    <Description>Repeats a configurable keystroke to whichever window has focus.</Description>

    <!-- The exe is unsigned, so SmartScreen will warn about it whatever we do. Filling in the
         metadata at least means the Properties dialog can say where it came from instead of
         showing a blank publisher. -->
    <Company>Albert Morlà</Company>
    <Authors>Albert Morlà</Authors>
    <Copyright>Copyright © 2026 Albert Morlà</Copyright>
    <ApplicationIcon>ChronoStroke.ico</ApplicationIcon>
    <!-- Development placeholder only. Released builds are stamped from the git tag by
         .github/workflows/release.yml, which passes -p:Version explicitly. -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- PublishSelfContained rather than SelfContained: the former applies only to publish,
         whereas SelfContained would also copy the whole runtime into bin on every ordinary
         build, for no benefit during development. -->
    <PublishSelfContained>true</PublishSelfContained>
    <PublishSingleFile>true</PublishSingleFile>

    <!-- Without this the native runtime .dlls sit next to the exe instead of inside it, which
         defeats the point of a single file. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- Roughly halves the produced exe in exchange for slightly slower first start. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- Drops the localised satellite assemblies for languages this app has no strings in. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- PublishTrimmed is deliberately absent: trimming is not supported for WPF. It builds,
         then fails at runtime when XAML resolves a type by name that the trimmer removed. -->

    <!-- PublishReadyToRun is absent because it was measured, not assumed. Precompiling makes
         cold start *worse* here: the R2R images add 4.6 MB to the exe, and every byte of that
         goes through the single-file decompression above before anything runs, which costs more
         than the JIT it saves. Two runs, nine starts each, warm medians 555 ms without against
         594 ms with, ranges not overlapping. Re-measure before reconsidering, and re-measure
         with EnableCompressionInSingleFile turned off, since that is what the trade is against. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>
