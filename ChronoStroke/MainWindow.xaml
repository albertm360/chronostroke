<Window x:Class="ChronoStroke.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChronoStroke"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
        Title="ChronoStroke"
        Width="420"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- The theme's RepeatButton is the one a scroll bar uses: its default style aligns it
             Left and Center, so it shrinks to the size of its glyph and only that patch takes
             the click. Stretching it is the whole fix — the rest strips the face and border so
             the arrows sit on the text box's own background.

             This has to be a Style rather than attributes on the buttons. WPF ranks a local
             value above a template trigger, so Background="Transparent" set on the element
             would beat the theme template's own pointer-over and pressed triggers and freeze
             the arrows dead on hover. As a Style setter it sits below them, and they win. -->
        <Style x:Key="SpinButtonStyle" TargetType="RepeatButton"
               BasedOn="{StaticResource {x:Type RepeatButton}}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="8" />
            <Setter Property="Delay" Value="500" />
            <Setter Property="Interval" Value="80" />
            <Style.Triggers>
                <!-- The theme paints a disabled button a solid grey, which on an arrow with no
                     face of its own reads as a slab appearing at the guard rails. Dimming the
                     glyph is the whole message. A Style trigger is what can say so: it outranks
                     the template trigger that would otherwise fill the background. -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="Transparent" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- Fluent's InfoBar has no WPF equivalent, so this is the whole control: a tinted,
             rounded box with an icon next to wrapping text. A ContentControl rather than a
             UserControl because the message is the only thing a caller supplies — Content is
             already the right property for it, and the severity styles below fill in the rest.

             The banner decides its own visibility. Every message it binds to is null exactly
             when there is nothing to say, so a caller passing Content is passing the answer to
             "should this be on screen" at the same time; a separate Has* flag and a
             BooleanToVisibilityConverter were two more things to keep in step for no gain.

             Tag carries the glyph. It is WPF's designated slot for a payload with no dedicated
             property, and adding a dependency property would mean a code-behind type for one
             string that only ever takes two values. -->
        <Style x:Key="BannerStyle" TargetType="ContentControl">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border CornerRadius="4"
                                Padding="12,10"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                Background="{TemplateBinding Background}">
                            <Grid ColumnDefinitions="Auto, *">
                                <TextBlock Grid.Column="0" Margin="0,0,8,0" FontSize="13"
                                           Foreground="{TemplateBinding Foreground}"
                                           Text="{TemplateBinding Tag}" />
                                <TextBlock Grid.Column="1" FontSize="12.5" TextWrapping="Wrap"
                                           Foreground="{TemplateBinding Foreground}"
                                           Text="{TemplateBinding Content}" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Content" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Blocking: the configuration will not run as it stands. -->
        <Style x:Key="CriticalBannerStyle" TargetType="ContentControl"
               BasedOn="{StaticResource BannerStyle}">
            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            <Setter Property="Tag" Value="&#x2297;" />
        </Style>

        <!-- Advisory: the configuration is legal and will run. Caution colour keeps it visually
             distinct from the blocking banner. -->
        <Style x:Key="CautionBannerStyle" TargetType="ContentControl"
               BasedOn="{StaticResource BannerStyle}">
            <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            <Setter Property="Tag" Value="&#x25B3;" />
        </Style>
    </Window.Resources>

    <Grid Margin="20" RowDefinitions="Auto, Auto, *, Auto">

        <TextBlock Grid.Row="0" Text="ChronoStroke" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Margin="0,4,0,0" FontSize="13.5"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Repeats a key into whichever window has focus" />

        <StackPanel Grid.Row="2" Margin="0,24,0,0">

            <TextBlock x:Name="SendLabel" Style="{StaticResource FieldLabelStyle}" Text="Key to send" Margin="0,0,0,6" />
            <local:KeyCaptureBox Combo="{Binding SendCombo}" IsEnabled="{Binding CanEdit}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=SendLabel}" />
            <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="Click the box, then press the key or combination you want repeated. Esc leaves the box." />

            <TextBlock x:Name="HotkeyLabel" Style="{StaticResource FieldLabelStyle}" Text="Start / stop hotkey" Margin="0,18,0,6" />
            <local:KeyCaptureBox Combo="{Binding Hotkey.Combo}" IsEnabled="{Binding CanEdit}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=HotkeyLabel}" />
            <ContentControl Style="{StaticResource CriticalBannerStyle}"
                            Content="{Binding HotkeyError}" />
            <ContentControl Style="{StaticResource CautionBannerStyle}"
                            Content="{Binding HotkeyWarning}" />

            <Grid Margin="0,18,0,0" ColumnDefinitions="*, Auto">

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="IntervalLabel" Style="{StaticResource FieldLabelStyle}" Text="Interval (ms)" Margin="0,0,0,6" />

                    <!-- WPF has no NumericUpDown, so the spinner is composed here. The
                         arrows sit inside the box's right edge rather than beside it, which is
                         what makes the two read as one control — the text box keeps its own
                         chrome and focus visuals, and its right padding is widened to the exact
                         width the arrows occupy so a long number never runs under them. Its
                         other three sides keep the theme's 10,5,_,6 so the digits line up with
                         the Step box alongside. -->
                    <Grid>
                        <TextBox Text="{Binding Interval.Text, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanEdit}"
                                 Padding="10,5,34,6"
                                 AutomationProperties.LabeledBy="{Binding ElementName=IntervalLabel}">
                            <!-- Up and down keys do what the arrows do, which is what anyone
                                 who has used a spinner before will try first. -->
                            <TextBox.InputBindings>
                                <KeyBinding Key="Up" Command="{Binding StepUpCommand}" />
                                <KeyBinding Key="Down" Command="{Binding StepDownCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <!-- Inset by 3 so the arrows clear the box's 1px border and its rounded
                             corners. Each button then fills half of what is left: a 28x13 click
                             target rather than the glyph on its own. -->
                        <Grid Width="28"
                              Margin="0,3,3,3"
                              HorizontalAlignment="Right"
                              RowDefinitions="*, *">
                            <RepeatButton Grid.Row="0"
                                          Style="{StaticResource SpinButtonStyle}"
                                          Content="&#x25B2;"
                                          Command="{Binding StepUpCommand}"
                                          AutomationProperties.Name="Increase interval" />
                            <RepeatButton Grid.Row="1"
                                          Style="{StaticResource SpinButtonStyle}"
                                          Content="&#x25BC;"
                                          Command="{Binding StepDownCommand}"
                                          AutomationProperties.Name="Decrease interval" />
                        </Grid>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1" Width="96" Margin="12,0,0,0">
                    <TextBlock x:Name="StepLabel" Style="{StaticResource FieldLabelStyle}" Text="Step (ms)" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Step.Text, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanEdit}"
                             AutomationProperties.LabeledBy="{Binding ElementName=StepLabel}" />
                </StackPanel>
            </Grid>

            <TextBlock Margin="0,6,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="{Binding RangeHint}" />

            <ContentControl Style="{StaticResource CriticalBannerStyle}"
                            Content="{Binding Interval.Error}" />
            <ContentControl Style="{StaticResource CriticalBannerStyle}"
                            Content="{Binding Step.Error}" />

            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button Padding="16,8"
                        Content="Start"
                        Command="{Binding StartCommand}"
                        Style="{DynamicResource AccentButtonStyle}" />
                <Button Padding="16,8"
                        Margin="8,0,0,0"
                        Content="Stop"
                        Command="{Binding StopCommand}" />
            </StackPanel>
        </StackPanel>

        <!-- A Grid rather than a horizontal StackPanel: the status text needs a constrained,
             star-sized column to wrap into, which a StackPanel — sized to its content's natural
             width — will not give it. -->
        <Grid Grid.Row="3" Margin="0,24,0,0" RowDefinitions="Auto, Auto" ColumnDefinitions="Auto, *">
            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                    Margin="0,0,0,14"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" />

            <Ellipse Grid.Row="1" Grid.Column="0" Width="7" Height="7" Margin="0,2,8,0" VerticalAlignment="Top">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>

            <!-- LiveSetting makes a screen reader announce status changes as they happen. Without
                 it the line is readable only if the user goes looking for it, which defeats the
                 point of a line whose whole job is to report what just happened. -->
            <TextBlock Grid.Row="1" Grid.Column="1"
                       Text="{Binding Status}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       AutomationProperties.LiveSetting="Polite" />
        </Grid>
    </Grid>
</Window>
