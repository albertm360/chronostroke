<Window x:Class="ChronoStroke.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChronoStroke"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
        Title="ChronoStroke"
        Width="420" Height="530"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Built into WPF; no custom converter needed. -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="20" RowDefinitions="Auto, Auto, *, Auto">

        <TextBlock Grid.Row="0" Text="ChronoStroke" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Margin="0,4,0,0" Text="Repeats a key into whichever window has focus" Opacity="0.7" />

        <StackPanel Grid.Row="2" Margin="0,24,0,0">

            <TextBlock Text="Key to send" Margin="0,0,0,6" />
            <local:KeyCaptureBox Combo="{Binding SendCombo}" IsEnabled="{Binding CanEdit}" />
            <TextBlock Margin="0,6,0,0" Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                       Text="Click the box, then press the key or combination you want repeated." />

            <TextBlock Text="Start / stop hotkey" Margin="0,18,0,6" />
            <local:KeyCaptureBox Combo="{Binding HotkeyCombo}" IsEnabled="{Binding CanEdit}" />
            <TextBlock Margin="0,6,0,0"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       Text="{Binding HotkeyError}"
                       Visibility="{Binding HasHotkeyError, Converter={StaticResource BoolToVis}}" />

            <TextBlock Text="Interval (ms)" Margin="0,18,0,6" />
            <TextBox Text="{Binding IntervalText, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding CanEdit}" />
            <TextBlock Margin="0,6,0,0"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       Text="{Binding IntervalError}"
                       Visibility="{Binding HasIntervalError, Converter={StaticResource BoolToVis}}" />

            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button Padding="16,8"
                        Content="Start"
                        Command="{Binding StartCommand}"
                        Style="{DynamicResource AccentButtonStyle}" />
                <Button Padding="16,8"
                        Margin="8,0,0,0"
                        Content="Stop"
                        Command="{Binding StopCommand}" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="3"
                   Text="{Binding Status}"
                   TextWrapping="Wrap"
                   Opacity="0.7" />
    </Grid>
</Window>
